--[[
    RetroBreach — webhook_logger  v1.2
    HWID ban logic removed — tracking and notifications only.

    Loaded by the hub through loadstring(game:HttpGet(...)).
    Returns a table. The hub sets URL / API / TOKEN and calls Init().

    It does two jobs that are deliberately separate:

      1. DISCORD WEBHOOK  — a fat embed so you see a launch the moment it
         happens, in whatever channel you pointed the webhook at.
      2. BOT ENDPOINT     — a JSON POST to your own bot (see /bot). That is
         what fills the database: run counts, accounts, executors and
         "playing now" heartbeats.

    Either one can be disabled. Leave Logger.API empty and you still get
    embeds. Leave Logger.URL empty and you still get tracking.

    No ban/kick logic here on purpose: the free host does not need the
    extra round trip, and blocking people is the loader's job, not the
    logger's.

    ------------------------------------------------------------------
    v1.2 — WHY THIS FILE WAS BROKEN
    ------------------------------------------------------------------
    Symptom: "[RBLogger] no http request function available" x4 and
             "this executor has no loadstring, nothing can be fetched".

    Cause: the old resolver did rawget(_G, name) and then rawget(getfenv(0), name).
    On executors that sandbox each script, _G is a fresh empty-ish table and
    getfenv is either absent or returns that same sandboxed table. So every
    executor global (request / syn / loadstring / identifyexecutor) came back
    nil even though the executor had all of them.

    Fix: resolve through every environment table that exists —
    getgenv() (the real executor global table on Synapse X, Script-Ware,
    KRNL, Fluxus, Electron, Arceus...), getfenv(0/1/2), _G, _ENV — and if
    rawget misses, retry with a metatable-aware pcall index (some namespaces
    are userdata with __index, e.g. syn on a few builds).

    Fallbacks added:
      * request  -> syn.request / http.request / fluxus.request / http_request /
                    httprequest / krnl.request ... incl. userdata namespaces
      * if still nothing -> HttpService:RequestAsync (works for the bot
                    endpoint, Discord rejects the Roblox user-agent with 403,
                    which is exactly why the executor-level fn is preferred)
      * loadstring -> load (Luau's load() compiles a string chunk)

    ------------------------------------------------------------------
    CONFIG (set these from the hub, before calling Init)
    ------------------------------------------------------------------
    Logger.URL            Discord webhook URL  (embed notifications)
    Logger.API            http://host:port      (your bot, no trailing slash)
    Logger.TOKEN          shared secret, must match bot/config.json apiToken
    Logger.GeoLookup      true  = resolve country / ISP from the public IP
    Logger.Heartbeat      60    seconds between "still playing" pings
    Logger.HeartbeatExit  true  = report when the game closes
]]

-- ============================================================
-- ENVIRONMENT / GLOBAL RESOLVER  (the v1.2 fix)
--
-- Nothing here names an executor global directly, so Luau's linter
-- stays quiet and there is no "Unknown global" spam.
-- ============================================================
local ENVS = {}
do
    local seen = {}
    local function add(t)
        if type(t) == "table" and not seen[t] then
            seen[t] = true
            ENVS[#ENVS + 1] = t
        end
    end

    add(_G)
    pcall(function() if type(getgenv)  == "function" then add(getgenv())  end end)
    pcall(function() if type(getrenv)  == "function" then add(getrenv())  end end)
    pcall(function() if type(getfenv)  == "function" then add(getfenv(0)) end end)
    pcall(function() if type(getfenv)  == "function" then add(getfenv(1)) end end)
    pcall(function() if type(getfenv)  == "function" then add(getfenv(2)) end end)
    pcall(function() add(_ENV) end)
end

local function gget(name)
    for i = 1, #ENVS do
        local v = rawget(ENVS[i], name)
        if v ~= nil then return v end
    end
    -- metatable-aware pass: catches userdata namespaces and __index chains
    for i = 1, #ENVS do
        local ok, v = pcall(function() return ENVS[i][name] end)
        if ok and v ~= nil then return v end
    end
    return nil
end

-- ============================================================
-- HTTP
-- Every executor names this differently. Try them all once.
-- ============================================================
local requestFn, requestName = nil, nil
do
    for _, n in ipairs({
        "request", "http_request", "httprequest", "HttpRequest",
        "request_async", "httprequest_async",
    }) do
        local f = gget(n)
        if type(f) == "function" then requestFn, requestName = f, n; break end
    end

    if not requestFn then
        -- namespace form. `syn` is a table on most builds and userdata on a
        -- few, so index inside a pcall instead of type-checking for table.
        for _, ns in ipairs({
            "http", "syn", "fluxus", "krnl", "KRNL", "Arceus",
            "Sentinel", "Electron", "Valyse", "Cryptic", "Celestial",
        }) do
            local t = gget(ns)
            if t ~= nil then
                local ok, f = pcall(function() return t.request end)
                if ok and type(f) == "function" then
                    requestFn, requestName = f, ns .. ".request"; break
                end
                local ok2, f2 = pcall(function() return t.HttpRequest end)
                if ok2 and type(f2) == "function" then
                    requestFn, requestName = f2, ns .. ".HttpRequest"; break
                end
                local ok3, f3 = pcall(function() return t.httprequest end)
                if ok3 and type(f3) == "function" then
                    requestFn, requestName = f3, ns .. ".httprequest"; break
                end
            end
        end
    end

    -- callable userdata (a couple of executors expose request as such)
    if not requestFn then
        local t = gget("request")
        if t ~= nil and type(t) ~= "function" then
            requestFn, requestName = function(o) return t(o) end, "request(userdata)"
        end
    end
end

