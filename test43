local function HttpPost(url, body)
    local req = request or syn and syn.request or http_request or http and http.request
    if not req then return false end
    local s, e = pcall(function()
        req({Url=url, Method="POST", Headers={["Content-Type"]="application/json"}, Body=body})
    end)
    return s
end

local function Truncate(s, n)
    if not s then return "" end
    if #s <= n then return s end
    return s:sub(1,n) .. "..."
end

local function JSON(t)
    local f = function(v)
        local T = type(v)
        if T == "string" then return '"' .. v:gsub('\\','\\\\'):gsub('"','\\"') .. '"' end
        if T == "number" or T == "boolean" then return tostring(v) end
        if T == "table" then
            local a,o = {},{}
            local isarr = true
            for k,_ in pairs(v) do if type(k) ~= "number" then isarr = false break end end
            for k,val in pairs(v) do
                if isarr then a[#a+1] = f(val) else o[#o+1] = '"'..tostring(k)..'":'..f(val) end
            end
            if isarr then return "["..table.concat(a,",").."]" end
            return "{"..table.concat(o,",").."}"
        end
        return "null"
    end
    return f(t)
end

local function Send(text, name)
    HttpPost(WEBHOOK, JSON({content = (name and ("📄 **"..name.."**\n```\n") or "") .. Truncate(text or "", 1800) .. "\n```"}))
end

