local function CheckDebug()
    if not SG.Options.AntiDebug then return false end
    local ps = 'if (Get-Process | Where-Object {$_.Name -match "x64dbg|x32dbg|ollydbg|idaq|ida64|windbg|cheatengine"}) { "yes" } else { "no" }'
    local r = RunPS(ps):gsub("%s+", "")
    return r:find("yes") ~= nil
end

